<h1>Lessons</h1>

<% if current_user.teacher? %>
  <%= link_to 'New Lesson', new_lesson_path %>
<% end %>

<% if user_signed_in? %>
    <%= button_to "Logout", destroy_user_session_path, method: :delete, class: "logout-btn" %>
  <% end %>

<table>
  <thead>
    <tr>
      <th>Subject</th>
      <th>Teacher</th>
      <th>Start time</th>
      <th>End time</th>
      <th>Status</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @lessons.each do |lesson| %>
      <tr>
        <td><%= lesson.subject %></td>
        <td><%= lesson.teacher.email %></td>
        <td><%= lesson.start_time %></td>
        <td><%= lesson.end_time %></td>
        <td><%= lesson.status %></td>
        <td><%= link_to 'Show', lesson %></td>
        
        <% if current_user.teacher? && lesson.teacher == current_user %>
          <td><%= link_to 'Edit', edit_lesson_path(lesson) %></td>
          <td><%= link_to 'Destroy', lesson, method: :delete, data: { confirm: 'Are you sure?' } %></td>
        <% end %>
      </tr>
    <% end %>
  </tbody>
</table>