<div id="<%= dom_id lesson %>">
  <p>
    <strong>Subject:</strong>
    <%= lesson.subject %>
  </p>

  <p>
    <strong>Start time:</strong>
    <%= lesson.start_time %>
  </p>

  <p>
    <strong>End time:</strong>
    <%= lesson.end_time %>
  </p>

  <p>
    <strong>Status:</strong>
    <%= lesson.status %>
  </p>

  <p>
    <strong>Teacher:</strong>
    <%= lesson.teacher_id %>
  </p>

</div>
